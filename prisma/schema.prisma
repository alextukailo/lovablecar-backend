generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum EngineType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  OTHER
  UNKNOWN
}

enum TransmissionType {
  MANUAL
  AUTOMATIC
  CVT
  DCT
  OTHER
  UNKNOWN
}

enum DrivetrainType {
  FWD
  RWD
  AWD
  FOUR_WD
  UNKNOWN
}

enum TimingSystemType {
  BELT
  CHAIN
  OTHER
  UNKNOWN
}

enum MaintenanceType {
  ENGINE_OIL
  ENGINE_AIR_FILTER
  CABIN_FILTER
  FUEL_FILTER
  SPARK_PLUGS
  TRANSMISSION_OIL
  TIMING_BELT
  TIMING_CHAIN_INSPECTION
  BRAKE_FLUID
  COOLANT
  HALDEX_OIL
  HALDEX_FILTER
  FRONT_DIFFERENTIAL_OIL
  REAR_DIFFERENTIAL_OIL
  TRANSFER_CASE_OIL
  AUXILIARY_BELT
  CUSTOM
}

enum MaintenanceNotificationType {
  UPCOMING
  DUE
  OVERDUE
}

model User {
  id String @id @default(cuid())

  // Set only after the backend has verified
  // the Telegram authentication response.
  telegramUserId String @unique

  customNotifications CustomNotification[]

  firstName String?
  lastName  String?
  username  String?
  photoUrl  String?

  cars               Car[]
  sessions           UserSession[]
  telegramConnection TelegramConnection?
  telegramLinkTokens TelegramLinkToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserSession {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Store a hash of the session token,
  // never the raw bearer token.
  tokenHash String @unique

  expiresAt DateTime
  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model TelegramConnection {
  id String @id @default(cuid())

  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Telegram private chat identifier, stored as
  // a string to avoid JavaScript integer issues.
  chatId String @unique

  // A bot conversation is linked only after
  // a verified account-linking flow.
  connectedAt DateTime @default(now())

  notificationsEnabled Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Car {
  id              String  @id @default(cuid())
  make            String
  model           String
  year            Int
  engine          String?
  vin             String?
  licensePlate    String?
  mileage         Int     @default(0)
  isPrimary       Boolean @default(false)
  photoStorageKey String?

  engineType       EngineType?
  transmissionType TransmissionType?
  drivetrainType   DrivetrainType?
  timingSystemType TimingSystemType?

  // Nullable during migration so existing cars
  // remain intact until ownership is assigned.
  ownerId String?
  owner   User?   @relation(fields: [ownerId], references: [id], onDelete: Restrict)

  serviceRecords       ServiceRecord[]
  maintenanceSchedules MaintenanceSchedule[]
  mileageReadings      MileageReading[]
  mileageReminder      MileageReminder?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([ownerId])
}

model ServiceRecord {
  id    String @id @default(cuid())
  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)

  date        DateTime
  mileage     Int
  title       String
  description String?
  cost        Decimal? @db.Decimal(10, 2)
  currency    String   @default("PLN")
  workshop    String?

  legacyLocalId String? @unique

  completedMaintenance MaintenanceCompletion[]
  maintenanceSchedule  MaintenanceSchedule?    @relation("ServiceSchedule")

  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  serviceAttachments ServiceAttachment[]

  @@index([carId, date])
}

model MaintenanceSchedule {
  id    String @id @default(cuid())
  carId String
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)

  type        MaintenanceType
  customTitle String?
  enabled     Boolean         @default(true)

  intervalKm     Int?
  intervalMonths Int?

  lastServiceMileage Int?
  lastServiceDate    DateTime?

  nextDueMileage Int?
  nextDueDate    DateTime?

  warningKm   Int @default(1000)
  warningDays Int @default(30)

  notes String?

  sourceServiceRecordId String?        @unique
  sourceServiceRecord   ServiceRecord? @relation("ServiceSchedule", fields: [sourceServiceRecordId], references: [id], onDelete: SetNull)

  completions   MaintenanceCompletion[]
  notifications MaintenanceNotification[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carId, enabled])
  @@index([nextDueDate])
  @@index([nextDueMileage])
}

model MaintenanceCompletion {
  id String @id @default(cuid())

  maintenanceScheduleId String
  serviceRecordId       String

  maintenanceSchedule MaintenanceSchedule @relation(fields: [maintenanceScheduleId], references: [id], onDelete: Cascade)
  serviceRecord       ServiceRecord       @relation(fields: [serviceRecordId], references: [id], onDelete: Cascade)

  // Identifies a single completion request.
  // Retrying the same request must not create
  // another service record.
  //
  // Optional for compatibility with existing rows.
  idempotencyKey String? @unique

  createdAt DateTime @default(now())

  @@unique([maintenanceScheduleId, serviceRecordId])
  @@index([serviceRecordId])
}

model MaintenanceNotification {
  id String @id @default(cuid())

  maintenanceScheduleId String
  maintenanceSchedule   MaintenanceSchedule @relation(fields: [maintenanceScheduleId], references: [id], onDelete: Cascade)

  type     MaintenanceNotificationType
  cycleKey String

  telegramChatId String?
  sentAt         DateTime?
  error          String?

  createdAt DateTime @default(now())

  @@unique([maintenanceScheduleId, cycleKey, type])
  @@index([sentAt])
}

enum MobileLoginStatus {
  PENDING
  APPROVED
  CONSUMED
}

model MobileLoginTransaction {
  id String @id @default(cuid())

  challengeHash    String
  browserStateHash String? @unique

  telegramOidcAttempts TelegramOidcAttempt[]

  status MobileLoginStatus @default(PENDING)

  userId String?

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // SHA-256 hash of the six-digit code
  // shown only in the mobile app.
  confirmationCodeHash String?

  // Number of incorrect confirmation attempts.
  confirmationAttempts Int @default(0)

  @@index([expiresAt])
  @@index([status, expiresAt])
}

model TelegramOidcAttempt {
  id String @id @default(cuid())

  validatedAttemptNumber Int?

  // Browser-state proof, stored temporarily for the OIDC callback.
  browserStateEncrypted String?

  // Confirmation-code proof, stored temporarily for the OIDC callback.
  confirmationCodeEncrypted String?

  // Links this OIDC authorization to an existing
  // LovableCar mobile login transaction.
  transactionId String
  transaction   MobileLoginTransaction @relation(fields: [transactionId], references: [id], onDelete: Cascade)

  // Store only a SHA-256 hash of the OAuth state.
  stateHash String @unique

  // PKCE verifier is needed for the token exchange.
  codeVerifier String

  // Used to verify the ID token belongs to this attempt.
  nonce String

  expiresAt  DateTime
  consumedAt DateTime?

  createdAt DateTime @default(now())

  @@index([transactionId])
  @@index([expiresAt])
}

model TelegramLoginReplay {
  id String @id @default(cuid())

  // SHA-256 digest of the canonical signed
  // Telegram login response.
  payloadHash String @unique

  // The mobile login transaction for which
  // this Telegram response was accepted.
  transactionId String

  createdAt DateTime @default(now())
  expiresAt DateTime

  @@index([expiresAt])
}

model RateLimitCounter {
  id String @id @default(cuid())

  // SHA-256 hash of the limiter name
  // and tracked client identifier.
  keyHash String @unique

  // Current fixed-window request count.
  count Int @default(0)

  // End of the current rate-limit window.
  expiresAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([expiresAt])
}

model TelegramLinkToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([expiresAt])
}

model MileageReading {
  id        String   @id @default(cuid())
  carId     String
  car       Car      @relation(fields: [carId], references: [id], onDelete: Cascade)
  mileage   Int
  source    String   @default("TELEGRAM")
  createdAt DateTime @default(now())

  @@index([carId, createdAt])
}

model MileageReminder {
  carId String @id
  car   Car    @relation(fields: [carId], references: [id], onDelete: Cascade)

  nextDueAt       DateTime  @default(now())
  pendingSince    DateTime?
  lastSentAt      DateTime?
  lastSubmittedAt DateTime?
  leaseUntil      DateTime?

  // Telegram message ID used to match
  // mileage replies to reminder messages.
  telegramMessageId Int?

  @@index([nextDueAt])
}

model ServiceAttachment {
  id String @id @default(cuid())

  serviceId String
  service   ServiceRecord @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  fileName   String
  mimeType   String
  size       Int
  storageKey String @unique

  createdAt           DateTime             @default(now())
  customNotifications CustomNotification[]

  @@index([serviceId])
}

enum CustomNotificationStatus {
  PENDING
  SENDING
  SENT
  FAILED
}

model CustomNotification {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  text String

  scheduledAt DateTime
  timeZone    String   @default("UTC")

  attachments ServiceAttachment[]

  status CustomNotificationStatus @default(PENDING)

  sentAt            DateTime?
  telegramMessageId Int?

  claimedAt DateTime?
  attempts  Int       @default(0)
  lastError String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, scheduledAt])
  @@index([status, scheduledAt])
}
